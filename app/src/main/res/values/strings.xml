    <string name="intro">Bloque automatiquement, depuis l’appli X, les comptes listés sur onbloquelextremedroite.fun.</string>

    <string name="x_missing_title">L’appli X n’est pas installée</string>
    <string name="x_missing_body">Le blocage passe par l’appli X officielle. Installe-la et connecte-toi, puis reviens ici.</string>
    <string name="x_install">Installer X</string>

    <string name="service_title">Service d’accessibilité</string>
    <string name="service_on">Activé. L’appli peut piloter X à ta place.</string>
    <string name="service_off">Désactivé. Active-le pour que l’appli puisse bloquer dans X.</string>
    <string name="service_enable">Activer</string>
    <string name="disclosure_title">Avant d’activer</string>
    <string name="disclosure_body">Le service lit l’écran de l’appli X et appuie à ta place sur ⋯, Bloquer puis sur la confirmation. Il n’agit que dans X, seulement quand tu lances un blocage, et n’envoie aucune donnée.</string>
    <string name="disclosure_restricted">Si l’interrupteur est grisé\u00A0: ouvre Infos de l’appli, menu ⋮, «\u00A0Autoriser les paramètres restreints\u00A0», puis reviens activer le service.</string>
